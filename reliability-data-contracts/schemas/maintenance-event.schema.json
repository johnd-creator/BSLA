{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliability-data-contracts/schemas/maintenance-event.schema.json",
  "title": "MaintenanceEvent",
  "description": "Vendor-neutral maintenance execution event, also used as the MX-007R canonical maintenance_event contract. Legacy fields remain compatible; v1 provenance and evidence are optional during migration.",
  "type": "object",
  "required": ["id", "equipment_id"],
  "properties": {
    "canonical_id": {"type": ["string", "null"], "description": "NADI-owned stable event identity."},
    "contract_version": {"type": ["string", "null"], "const": "1.0"},
    "id": {
      "type": "string",
      "description": "Stable event identifier (typically the originating work order id)"
    },
    "equipment_id": {
      "type": "string",
      "description": "Asset the event was performed on"
    },
    "work_order_id": {
      "type": ["string", "null"],
      "description": "Originating work order, if applicable"
    },
    "event_type": {
      "type": ["string", "null"],
      "enum": ["CM", "PM", "INSPECTION", "CALIBRATION", "REPAIR", "EMERGENCY", null],
      "description": "CM=corrective, PM=preventive, etc."
    },
    "description": {"type": ["string", "null"], "description": "Retained work order description; no personnel or raw source payload."},
    "status": {
      "type": ["string", "null"],
      "description": "Completion status e.g. CLOSE, COMP, WAPPR"
    },
    "actual_start": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "actual_finish": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "duration_hours": {
      "type": ["number", "null"],
      "description": "Elapsed hours from valid timezone-aware actual_finish minus actual_start for CLOSE work orders; never status/schedule dates, labor effort or equipment downtime"
    },
    "labor_hours": {
      "type": ["number", "null"]
    },
    "downtime_hours": {
      "type": ["number", "null"],
      "description": "Equipment downtime attributable to this event"
    },
    "failure_code": {
      "type": ["string", "null"],
      "description": "Raw source failure classification when supplied. Presence does not establish a failure occurrence or failure count."
    },
    "reported_by": {
      "type": ["string", "null"]
    },
    "lead": {
      "type": ["string", "null"]
    },
    "source_changed_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "changedate from the originating work order; delta-sync watermark"
    },
    "sources": {
      "type": "object",
      "properties": {
        "maximo": {
          "type": ["object", "null"],
          "description": "Derived from mxwodetail actual fields (site BSR)",
          "properties": {
            "reliability_evidence": {
              "type": "object",
              "description": "Allowlisted, scoped and versioned source observations only. No failure occurrence, failure timestamp, resolved origin/parent, restoration time, operating exposure or KPI is inferred.",
              "required": [
                "schema_version",
                "semantics",
                "identity",
                "fields"
              ],
              "properties": {
                "schema_version": {
                  "const": 1
                },
                "semantics": {
                  "const": "SOURCE_FIELDS_ONLY"
                },
                "identity": {
                  "type": "object",
                  "properties": {
                    "wonum": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "assetnum": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "siteid": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "orgid": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "fields": {
                  "type": "object",
                  "propertyNames": {
                    "enum": [
                      "failurecode",
                      "problemcode",
                      "parent",
                      "origrecordclass",
                      "origrecordid",
                      "woclass",
                      "istask",
                      "haschildren",
                      "hasfollowupwork",
                      "downtime",
                      "faildate"
                    ]
                  },
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "state",
                      "value",
                      "source_changed_at"
                    ],
                    "properties": {
                      "state": {
                        "enum": [
                          "UNAVAILABLE",
                          "MISSING",
                          "INVALID",
                          "NAIVE",
                          "VALID",
                          "OBSERVED"
                        ]
                      },
                      "value": {
                        "type": [
                          "string",
                          "boolean",
                          "null"
                        ],
                        "maxLength": 200
                      },
                      "original": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 128
                      },
                      "source_changed_at": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "format": "date-time"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "origin": {
              "type": ["string", "null"],
              "enum": ["MXWODETAIL", null]
            },
            "wonum": {
              "type": ["string", "null"]
            },
            "assetnum": {
              "type": ["string", "null"]
            },
            "worktype": {
              "type": ["string", "null"]
            },
            "status": {
              "type": ["string", "null"]
            },
            "actstart": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "actfinish": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "actlabhrs": {
              "type": ["number", "null"]
            },
            "downtime": {
              "type": ["boolean", "number", "null"],
              "description": "MXWODETAIL source indicator. Historical numeric source values are not verified hours; current mapper emits only a verified boolean or null."
            },
            "failurecode": {
              "type": ["string", "null"]
            },
            "reportedby": {
              "type": ["string", "null"]
            },
            "lead": {
              "type": ["string", "null"]
            },
            "changedate": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        }
      }
    },
    "provenance": {
      "type": ["object", "null"],
      "required": ["source_system", "source_object", "source_record_id"],
      "properties": {
        "source_system": {"const": "MAXIMO"},
        "source_application": {"type": ["string", "null"]},
        "source_object": {"type": "string"},
        "source_record_id": {"type": "string"},
        "source_number": {"type": ["string", "null"]},
        "source_site": {"type": ["string", "null"]},
        "source_organization": {"type": ["string", "null"]},
        "source_created_at": {"type": ["string", "null"], "format": "date-time"},
        "source_updated_at": {"type": ["string", "null"], "format": "date-time"},
        "ingested_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "relationship_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["DIRECT_VERIFIED", "DERIVED_VERIFIED_PATH", "UNRESOLVED", "DEFERRED"]},
          "path": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "site_code": {"type": ["string", "null"]},
    "organization_code": {"type": ["string", "null"]}
  }
}
