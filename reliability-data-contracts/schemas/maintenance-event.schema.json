{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reliability-data-contracts/schemas/maintenance-event.schema.json",
  "title": "MaintenanceEvent",
  "description": "Vendor-neutral maintenance execution event, also used as the MX-007R canonical maintenance_event contract. Legacy fields remain compatible; v1 provenance and evidence are optional during migration.",
  "$defs": {
    "woDetailField": {
      "type": "object",
      "required": [
        "value",
        "state",
        "origin",
        "epoch_seconds"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ],
          "maxLength": 4000
        },
        "state": {
          "enum": [
            "SOURCE_VALUE",
            "RETAINED_LEGACY_VALUE",
            "SOURCE_CONFIRMED_EMPTY",
            "SOURCE_NOT_YET_VERIFIED",
            "SOURCE_VALUE_INVALID",
            "SOURCE_TIMESTAMP_INVALID"
          ]
        },
        "origin": {
          "enum": [
            "MAXIMO_RESPONSE",
            "LEGACY_COLUMN"
          ]
        },
        "epoch_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "source_changed_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      },
      "additionalProperties": false
    },
    "woDetail": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "identity": {
          "type": "object",
          "properties": {
            "wonum": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "assetnum": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "siteid": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            },
            "orgid": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 160
            }
          },
          "additionalProperties": false
        },
        "source_changed_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "collected_at": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "fields": {
          "type": "object",
          "properties": {
            "description": {
              "$ref": "#/$defs/woDetailField"
            },
            "status_description": {
              "$ref": "#/$defs/woDetailField"
            },
            "work_class": {
              "$ref": "#/$defs/woDetailField"
            },
            "priority": {
              "$ref": "#/$defs/woDetailField"
            },
            "priority_description": {
              "$ref": "#/$defs/woDetailField"
            },
            "location_id": {
              "$ref": "#/$defs/woDetailField"
            },
            "source_parent": {
              "$ref": "#/$defs/woDetailField"
            },
            "source_task_reference": {
              "$ref": "#/$defs/woDetailField"
            },
            "wo_group": {
              "$ref": "#/$defs/woDetailField"
            },
            "is_task": {
              "$ref": "#/$defs/woDetailField"
            },
            "has_children": {
              "$ref": "#/$defs/woDetailField"
            },
            "reported_at": {
              "$ref": "#/$defs/woDetailField"
            },
            "status_changed_at": {
              "$ref": "#/$defs/woDetailField"
            },
            "scheduled_start": {
              "$ref": "#/$defs/woDetailField"
            },
            "scheduled_finish": {
              "$ref": "#/$defs/woDetailField"
            },
            "target_completion": {
              "$ref": "#/$defs/woDetailField"
            },
            "estimated_duration_hours": {
              "$ref": "#/$defs/woDetailField"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "schema_version",
        "identity",
        "source_changed_at",
        "fields"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["id", "equipment_id"],
  "properties": {
    "canonical_id": {"type": ["string", "null"], "description": "NADI-owned stable event identity."},
    "contract_version": {"type": ["string", "null"], "const": "1.0"},
    "id": {
      "type": "string",
      "description": "Stable event identifier (typically the originating work order id)"
    },
    "equipment_id": {
      "type": "string",
      "description": "Asset the event was performed on"
    },
    "work_order_id": {
      "type": ["string", "null"],
      "description": "Originating work order, if applicable"
    },
    "event_type": {
      "type": ["string", "null"],
      "enum": ["CM", "PM", "INSPECTION", "CALIBRATION", "REPAIR", "EMERGENCY", null],
      "description": "CM=corrective, PM=preventive, etc."
    },
    "status": {
      "type": ["string", "null"],
      "description": "Completion status e.g. CLOSE, COMP, WAPPR"
    },
    "actual_start": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "actual_finish": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "duration_hours": {
      "type": ["number", "null"],
      "description": "Realized execution duration (actual_finish - actual_start)"
    },
    "labor_hours": {
      "type": ["number", "null"]
    },
    "downtime_hours": {
      "type": ["number", "null"],
      "description": "Equipment downtime attributable to this event"
    },
    "failure_code": {
      "type": ["string", "null"],
      "description": "Failure code if the event was failure-related"
    },
    "reported_by": {
      "type": ["string", "null"]
    },
    "lead": {
      "type": ["string", "null"]
    },
    "source_changed_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "changedate from the originating work order; delta-sync watermark"
    },
    "sources": {
      "type": "object",
      "properties": {
        "maximo": {
          "type": ["object", "null"],
          "description": "Derived from mxwodetail actual fields (site BSR)",
          "properties": {
            "wo_detail": {"$ref":"#/$defs/woDetail"},
            "origin": {
              "type": ["string", "null"],
              "enum": ["MXWODETAIL", null]
            },
            "wonum": {
              "type": ["string", "null"]
            },
            "assetnum": {
              "type": ["string", "null"]
            },
            "worktype": {
              "type": ["string", "null"]
            },
            "status": {
              "type": ["string", "null"]
            },
            "actstart": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "actfinish": {
              "type": ["string", "null"],
              "format": "date-time"
            },
            "actlabhrs": {
              "type": ["number", "null"]
            },
            "downtime": {
              "type": ["number", "null"]
            },
            "failurecode": {
              "type": ["string", "null"]
            },
            "reportedby": {
              "type": ["string", "null"]
            },
            "lead": {
              "type": ["string", "null"]
            },
            "changedate": {
              "type": ["string", "null"],
              "format": "date-time"
            }
          }
        }
      }
    },
    "provenance": {
      "type": ["object", "null"],
      "required": ["source_system", "source_object", "source_record_id"],
      "properties": {
        "source_system": {"const": "MAXIMO"},
        "source_application": {"type": ["string", "null"]},
        "source_object": {"type": "string"},
        "source_record_id": {"type": "string"},
        "source_number": {"type": ["string", "null"]},
        "source_site": {"type": ["string", "null"]},
        "source_organization": {"type": ["string", "null"]},
        "source_created_at": {"type": ["string", "null"], "format": "date-time"},
        "source_updated_at": {"type": ["string", "null"], "format": "date-time"},
        "ingested_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "relationship_evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": {"enum": ["DIRECT_VERIFIED", "DERIVED_VERIFIED_PATH", "UNRESOLVED", "DEFERRED"]},
          "path": {"type": "array", "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "site_code": {"type": ["string", "null"]},
    "organization_code": {"type": ["string", "null"]}
  }
}
